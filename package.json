{
  "name": "pat-pat",
  "displayName": "Pat Pat",
  "description": "Parallel branch helper for vibe coding.",
  "version": "0.0.1",
  "publisher": "patpat.dev",
  "icon": "media/patpat.svg",
  "engines": {
    "vscode": "^1.64.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:patPat.abortAll",
    "onCommand:patPat.bootstrapIntegration",
    "onCommand:patPat.clearAll",
    "onCommand:patPat.diagnoseSessions",
    "onCommand:patPat.editSessionCommand",
    "onCommand:patPat.killAll",
    "onCommand:patPat.newFeatPat",
    "onCommand:patPat.openFeature",
    "onCommand:patPat.removeFeatPat",
    "onCommand:patPat.runSession",
    "onView:patPatActivityView",
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "echo \"No tests yet\""
  },
  "contributes": {
    "commands": [
      {
        "command": "patPat.bootstrapIntegration",
        "category": "Pat Pat",
        "title": "Bootstrap inte-pat"
      },
      {
        "command": "patPat.newFeatPat",
        "category": "Pat Pat",
        "title": "New feat-pat"
      },
      {
        "command": "patPat.runSession",
        "category": "Pat Pat",
        "title": "Run feat-pat session"
      },
      {
        "command": "patPat.editSessionCommand",
        "category": "Pat Pat",
        "title": "Edit session start command"
      },
      {
        "command": "patPat.configFeature",
        "category": "Pat Pat",
        "title": "Configure feat-pat"
      },
      {
        "command": "patPat.removeFeatPat",
        "category": "Pat Pat",
        "title": "Remove feat-pat"
      },
      {
        "command": "patPat.diagnoseSessions",
        "category": "Pat Pat",
        "title": "Diagnose sessions"
      },
      {
        "command": "patPat.openFeature",
        "category": "Pat Pat",
        "title": "Open feat-pat"
      },
      {
        "command": "patPat.killAll",
        "category": "Pat Pat",
        "title": "Kill All feat-pat Terminals"
      },
      {
        "command": "patPat.clearAll",
        "category": "Pat Pat",
        "title": "Clear All feat-pat Terminals"
      },
      {
        "command": "patPat.abortAll",
        "category": "Pat Pat",
        "title": "Abort All feat-pat Terminals"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "patPatActivity",
          "title": "Pat Pat",
          "icon": "media/patpat.svg"
        }
      ]
    },
    "views": {
      "patPatActivity": [
        {
          "id": "patPatActivityView",
          "name": "Sessions"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "patPat.bootstrapIntegration",
          "when": "view == patPatActivityView",
          "group": "navigation@1"
        },
        {
          "command": "patPat.newFeatPat",
          "when": "view == patPatActivityView",
          "group": "navigation@2"
        },
        {
          "command": "patPat.diagnoseSessions",
          "when": "view == patPatActivityView",
          "group": "navigation@3"
        },
        {
          "command": "patPat.killAll",
          "when": "view == patPatActivityView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "patPat.runSession",
          "when": "view == patPatActivityView && viewItem == patPat.session",
          "group": "inline@1"
        },
        {
          "command": "patPat.editSessionCommand",
          "when": "view == patPatActivityView && viewItem == patPat.session",
          "group": "inline@2"
        },
        {
          "command": "patPat.configFeature",
          "when": "view == patPatActivityView && viewItem == patPat.feature",
          "group": "inline@1"
        },
        {
          "command": "patPat.removeFeatPat",
          "when": "view == patPatActivityView && viewItem == patPat.feature",
          "group": "inline@2"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.2.5",
    "@types/vscode": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "typescript": "^5.0.4"
  }
}
